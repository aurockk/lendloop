# Next.js app (.env.local). `npx convex dev` fills in the Convex URLs for you.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Convex deployment env (set with `npx convex env set NAME value`, NOT in this file) ----
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
# ADMIN_EMAILS=you@example.com                 # verified emails that become admins on sign-in
# N8N_LOAN_EVENTS_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-loan-events
# N8N_WEBHOOK_SECRET=<openssl rand -hex 32>    # Convex -> n8n signatures
# N8N_TO_CONVEX_SECRET=<openssl rand -hex 32>  # n8n -> Convex signatures
