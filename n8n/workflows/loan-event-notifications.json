    {
      "parameters": {
        "jsCode": "// Signs a JSON body for Convex: HMAC-SHA256 over `${timestamp}.${body}`.\n// The secret comes from the container env and never appears in workflow JSON\n// or execution data (only the resulting signature does).\nconst crypto = require('crypto');\nfunction signFor(path, payload) {\n  const secret = $env.LENDLOOP_N8N_TO_CONVEX_SECRET;\n  const base = $env.LENDLOOP_CONVEX_SITE_URL;\n  if (!secret || !base) throw new Error('LENDLOOP_N8N_TO_CONVEX_SECRET / LENDLOOP_CONVEX_SITE_URL not set');\n  const body = JSON.stringify(payload);\n  const timestamp = Math.floor(Date.now() / 1000).toString();\n  const signature = 'sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.${body}`).digest('hex');\n  return { url: base.replace(/\\/$/, '') + path, body, timestamp, signature };\n}\n\n// Reserve this event atomically in Convex before sending. Concurrent\n// executions for the same eventId (Convex retries) can't both get \"granted\".\nconst e = $('Verify signature').first().json.event;\nreturn [{ json: signFor('/n8n/claim', { key: `event:${e.eventId}` }) }];"
      },
