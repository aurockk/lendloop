    {
      "parameters": {
        "jsCode": "const e = $('Verify signature').first().json.event;\nconst app = ($env.LENDLOOP_APP_URL || 'http://localhost:3000').replace(/\\/$/, '');\nconst name = e.recipient.firstName || 'there';\nconst other = e.counterpart.firstName || 'A neighbour';\nconst tool = e.tool.name;\nconst dates = `${e.loan.startDate} to ${e.loan.endDate}`;\n\nconst templates = {\n  'request.created':   [`${other} would like to borrow your ${tool}`,\n                        `${other} asked to borrow your ${tool} from ${dates}.\\n\\nApprove or decline: ${app}/incoming`],\n  'request.cancelled': [`${other} cancelled their request for your ${tool}`,\n                        `The request for ${dates} was cancelled. No action needed.`],\n  'request.approved':  [`You can borrow the ${tool}`,\n                        `${other} approved your request for ${dates}. Arrange pickup with them, and please return it by ${e.loan.endDate}.\\n\\n${app}/requests`],\n  'request.declined':  [`Your request for the ${tool} was declined`,\n                        `${other} can't lend the ${tool} for ${dates}. Other tools are on the board: ${app}/tools`],\n  'loan.returned':     [`Thanks for returning the ${tool}`,\n                        `${other} confirmed the ${tool} is back. Thanks for keeping the loop going!`],\n};\nconst t = templates[e.event];\nif (!t) throw new Error(`Unknown event type: ${e.event}`);\nreturn [{ json: { to: e.recipient.email, subject: t[0], text: `Hi ${name},\\n\\n${t[1]}\\n\\n\u2014 LendLoop` } }];"
      },
