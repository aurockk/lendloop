      "parameters": {
        "jsCode": "// Verifies the HMAC signature Convex put on this request.\n// Convex signs JSON.stringify(payload); JSON.parse -> JSON.stringify reproduces\n// those exact bytes (key order and escaping are preserved), so we can verify\n// against the parsed body.\nconst crypto = require('crypto');\nconst { headers = {}, body = {} } = $input.first().json;\nconst secret = $env.LENDLOOP_N8N_WEBHOOK_SECRET;\nif (!secret) throw new Error('LENDLOOP_N8N_WEBHOOK_SECRET is not set');\n\nconst timestamp = String(headers['x-lendloop-timestamp'] || '');\nconst signature = String(headers['x-lendloop-signature'] || '');\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret)\n  .update(`${timestamp}.${JSON.stringify(body)}`).digest('hex');\nconst fresh = Math.abs(Date.now() / 1000 - Number(timestamp)) <= 300;\nconst valid = fresh && signature.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected));\n\n// Pass along only the fields the email needs.\nreturn [{ json: { valid, event: valid ? body : null } }];"
      },
