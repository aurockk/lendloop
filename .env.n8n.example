# Copied into the n8n container as env vars. Never commit the real .env.n8n.
# Must equal the Convex env var N8N_WEBHOOK_SECRET (Convex -> n8n signatures)
LENDLOOP_N8N_WEBHOOK_SECRET=
# Must equal the Convex env var N8N_TO_CONVEX_SECRET (n8n -> Convex signatures)
LENDLOOP_N8N_TO_CONVEX_SECRET=
# Convex HTTP actions URL. Local dev: http://host.docker.internal:3211
# Cloud dev:  https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
# Sender address for notification emails
LENDLOOP_MAIL_FROM=LendLoop <no-reply@lendloop.local>
# Used for links in emails
LENDLOOP_APP_URL=http://localhost:3000
